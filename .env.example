# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is already in .gitignore).

# Best Buy Products API key — free from https://developer.bestbuy.com
BESTBUY_API_KEY=

# Keepa API key (paid, optional) — https://keepa.com/#!api
# Leave blank to disable Amazon tracking.
KEEPA_API_KEY=

# ntfy topic name. Anyone who knows it can read your alerts, so make it long
# and random, e.g. glitch-alerts-7f3k9q2xv8
NTFY_TOPIC=

# Optional: only needed if you protect your topic or self-host ntfy.
NTFY_TOKEN=

# Optional: Discord webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=
